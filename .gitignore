!.env.*.example
.secrets/
.streamlit/secrets.toml
*.pem
*.key
*.p12
*.pfx

# Local OSMnx response cache and local database files
/cache/
*.db
*.sqlite
*.sqlite3

# Logs, temporary files, and package-manager debug logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp
*.swp
*.swo
~$*

# IDE and operating-system files
