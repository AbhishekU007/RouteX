*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Python virtual environments
venv/
.venv/
env/
.envdir/

# Node, Vite, and frontend build outputs
node_modules/
dist/
build/
.vite/
coverage/
frontend/dist/
